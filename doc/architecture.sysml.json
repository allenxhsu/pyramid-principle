      "isAbstract": false
    },
    "bl_004": {
      "id": "bl_004",
      "kind": "block",
      "name": "Lint engine",
      "ownerId": "pa_002",
      "doc": "26 structural checks, re-run on every edit, scoped to the step: problem definition, analysis structure, the introduction, vertical and horizontal logic. Heuristics on English — dismissable.",
      "isAbstract": false
    },
    "bl_013": {
      "id": "bl_013",
      "kind": "block",
      "name": "Walkthrough",
      "ownerId": "pa_002",
      "doc": "Twelve interactive lessons in Minto’s own illustrations, beside a worked example; the Guide view documents every rule.",
      "isAbstract": false
    },
    "bl_002": {
      "id": "bl_002",
      "kind": "block",
      "name": "Exporters",
      "ownerId": "pa_002",
      "doc": "Memo, email, slide outline, talk track; pyramid/1 JSON; JSON-LD graph and CSV triples, ids namespaced urn:pyramid:<doc>:<kind>:<node>.",
      "isAbstract": false
    },
