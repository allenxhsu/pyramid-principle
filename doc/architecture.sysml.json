    "re_001": {
      "id": "re_001",
      "kind": "requirement",
      "name": "Clocks move only for what changed",
      "ownerId": "pa_005",
      "doc": "",
      "reqId": "PY1",
      "text": "A record whose body is unchanged shall keep its updatedAt; a save that changes nothing writes nothing."
    },
    "re_002": {
      "id": "re_002",
      "kind": "requirement",
      "name": "Deletions are tombstones",
      "ownerId": "pa_005",
      "doc": "",
      "reqId": "PY2",
      "text": "A record that leaves the document shall be written back with deletedAt set, and exports shall carry tombstones."
    },
    "re_003": {
      "id": "re_003",
      "kind": "requirement",
      "name": "Never swap under the caret",
      "ownerId": "pa_005",
      "doc": "",
      "reqId": "PY3",
      "text": "Arriving changes shall wait while the caret is in a field, and the app shall say so."
    },
    "re_004": {
      "id": "re_004",
      "kind": "requirement",
      "name": "No external origin",
      "ownerId": "pa_005",
      "doc": "",
      "reqId": "PY4",
      "text": "The page shall reference no external origin — fonts included — so an installed copy works in airplane mode."
    },
    "re_005": {
      "id": "re_005",
      "kind": "requirement",
      "name": "Prefixed storage",
      "ownerId": "pa_005",
      "doc": "",
      "reqId": "PY5",
      "text": "Everything the app owns shall be named pyramid.*; ui-kit.* stays shared on purpose."
    },
    "re_006": {
      "id": "re_006",
      "kind": "requirement",
      "name": "Round-trips keep the analysis",
      "ownerId": "pa_005",
      "doc": "",
      "reqId": "PY6",
      "text": "Pyramid’s own state shall travel under x-pyramid, so a round-trip does not silently lose it."
    },
